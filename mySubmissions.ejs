<!DOCTYPE html>
<html>
<head>
    <title>My Submissions</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav>
    <a href="/">Home</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/my-submissions">My Submissions</a>
    <a href="/logout">Logout</a>
</nav>

<h1>My Submissions</h1>

<p>Recipes submitted by <%= currentUser.name %>:</p>

<% if (submissions.length === 0) { %>

    <p>You have no submissions yet.</p>

<% } else { %>

    <ul class="team-list">
    <% submissions.forEach(sub => { %>
        <li class="team-member">
            <h3><%= sub.recipeName %></h3>
            <p><%= sub.description %></p>
            <p><span class="label">Time:</span> <%= sub.time %></p>
            <p><span class="label">Submitted on:</span> <%= sub.date %></p>
        </li>
    <% }) %>
    </ul>

<% } %>

</body>
</html>
