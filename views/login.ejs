<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <nav>
        <a href="/">Home</a>
        <span style="color: white; margin-left: 20px;">Login</span>
    </nav>

    <main>

        <div class="auth-container">

            <h1>Login</h1>

            <% if (error) { %>
                <div class="auth-alert">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST" class="auth-form">

                <label for="email">Email</label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                >

                <label for="password">Password</label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    required
                >

                <button type="submit">
                    Login
                </button>

            </form>

            <p class="auth-link">
                Don't have an account?
                <a href="/register">Register</a>
            </p>

        </div>

    </main>

    <footer>
        <p>Quick Cooking Guide for Students</p>
    </footer>

</body>
</html>