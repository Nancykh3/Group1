<%- include('./partials/header') %>
<%- include('./partials/nav') %>

<main>

<h1>Submit Your Recipe</h1>

<form action="/submit" method="POST" class="submit-form">

    <label for="name">Recipe Name</label>
    <input type="text" id="name" name="name" required>

    <label for="description">Description</label>
    <textarea id="description" name="description" required></textarea>

    <label for="time">Preparation Time</label>
    <input type="text" id="time" name="time" placeholder="e.g. 5 minutes">

    <label for="ingredients">Ingredients (separate with commas)</label>
    <textarea id="ingredients" name="ingredients" placeholder="e.g. Bread, Peanut butter" required></textarea>

    <button type="submit">Submit Recipe</button>

</form>

</main>

<%- include('./partials/footer') %>