<%- include('./partials/header') %>
<%- include('./partials/nav') %>
<h1><%= title %></h1>

<h2>Project Description</h2>
<p><%= description %></p>

<h2>Problem Context</h2>
<p><%= problem %></p>

<h2>Team Information</h2>

<ul class="team-list">
<% team.forEach(member => { %>
    <li class="team-member">
        <h3><%= member.name %></h3>
        <p><span class="label">ID:</span> <%= member.ID %></p>
    </li>
<% }) %>
</ul>


<%- include('./partials/footer') %>